{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron/fetch-videos",      "schedule": "0 6 * * *"  },
    { "path": "/api/cron/transcribe-videos", "schedule": "10 6 * * *" },
    { "path": "/api/cron/analyze-mentions",  "schedule": "*/30 * * * *" }
  ],
  "functions": {
    "api/cron/fetch-videos.js":        { "maxDuration": 300 },
    "api/cron/transcribe-videos.js":   { "maxDuration": 300 },
    "api/cron/check-transcriptions.js":{ "maxDuration": 300 },
    "api/cron/analyze-mentions.js":    { "maxDuration": 300 },
    "api/dashboard/run-pipeline.js":   { "maxDuration": 120 },
    "api/dashboard/scan-all.js":       { "maxDuration": 30 },
    "api/dashboard/clear-pending.js":  { "maxDuration": 15 },
    "api/dashboard/stats.js":          { "maxDuration": 10 },
    "api/dashboard/mentions.js":       { "maxDuration": 10 },
    "api/dashboard/brands.js":         { "maxDuration": 10 },
    "api/dashboard/creators.js":       { "maxDuration": 10 },
    "api/dashboard/pipeline.js":       { "maxDuration": 10 },
    "api/report/weekly.js":            { "maxDuration": 30 },
    "api/slack/slash.js":              { "maxDuration": 60 },
    "api/slack/events.js":             { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control",          "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security","value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src https://fonts.gstatic.com https://api.fontshare.com; img-src 'self' data: https:; media-src https://stream.mux.com; connect-src 'self' https://stream.mux.com; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
