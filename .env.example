# =============================================================================
# Respawn Signal — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-side only, never expose to browser
SUPABASE_ANON_KEY=your_anon_key_here                   # safe for client-side / dashboard

# -----------------------------------------------------------------------------
# AssemblyAI — audio transcription
# -----------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# -----------------------------------------------------------------------------
# Anthropic / Claude — brand extraction
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6                         # model used for brand extraction

# -----------------------------------------------------------------------------
# TikTok API
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# -----------------------------------------------------------------------------
# Twitch API
# -----------------------------------------------------------------------------
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# -----------------------------------------------------------------------------
# Resend — email alerts
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=signal@yourdomain.com                # verified sender address in Resend
ALERT_EMAIL_TO=aj@respawnmediagroup.com                # default alert recipient (overridden per-creator)

# -----------------------------------------------------------------------------
# Slack — webhook alerts + two-way Agent Studio integration
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Required for two-way Slack ↔ Agent Studio (slash commands + @mentions)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here              # Bot User OAuth Token (from OAuth & Permissions)
SLACK_SIGNING_SECRET=your_signing_secret_here          # from Basic Information → App Credentials

# Your deployed app URL (used in agent response footers linking back to Agent Studio)
APP_URL=https://your-vercel-deployment.vercel.app

# -----------------------------------------------------------------------------
# Pipeline config
# -----------------------------------------------------------------------------
VIDEOS_PER_CREATOR=7                                   # how many recent videos to fetch per run
PIPELINE_CRON_SECRET=your_random_secret_here           # used to authenticate Vercel cron requests
